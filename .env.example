# Database Configuration
# Get this from Neon (neon.tech), Supabase, or Railway — paste your connection string here
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST/YOUR_DBNAME?sslmode=require

# Product API Configuration (Optional - for live product data)
# These are placeholder values - replace with real credentials if using external APIs

# Amazon Product Advertising API
# AMAZON_API_KEY=your_amazon_api_key
# AMAZON_API_SECRET=your_amazon_api_secret
# AMAZON_ASSOCIATE_TAG=your_associate_tag

# eBay API
# EBAY_API_KEY=your_ebay_api_key
# EBAY_API_BASE_URL=https://api.ebay.com

# Best Buy API
# BESTBUY_API_KEY=your_bestbuy_api_key

# Google Shopping API
# GOOGLE_SHOPPING_API_KEY=your_google_api_key
# GOOGLE_MERCHANT_ID=your_merchant_id

# LLM Integration (Optional - for enhanced explanations)
# OPENAI_API_KEY=sk-... (for GPT-4 enhanced rankings)
# COHERE_API_KEY=... (for alternative LLM)
# CLAUDE_API_KEY=... (for Claude models)
# LLM_MODEL=gpt-4

# Feature Flags
ENABLE_MOCK_PROVIDER=true
ENABLE_REAL_DATA_FALLBACK=true
CACHE_EXPIRY_HOURS=24

# Application Settings
NODE_ENV=development
# NODE_ENV=production

# Logging
LOG_LEVEL=info
# LOG_LEVEL=debug

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Timeout Settings
EXTERNAL_API_TIMEOUT_MS=5000
SEARCH_TIMEOUT_MS=10000
